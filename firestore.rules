rules_version = '2';

// Firestore Security Rules for GSB Bødekasse
//
// Current strategy: allow all operations for authenticated users.
// Tighten these rules before going to production.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    function isTeamAdmin(teamId) {
      return isSuperAdmin() || (
        isSignedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == "admin"
      );
    }

    match /featureProposals/{proposalId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && (
        request.resource.data.status == resource.data.status
        && request.resource.data.statusUpdatedAt == resource.data.statusUpdatedAt
        && request.resource.data.approvedAt == resource.data.approvedAt
        && request.resource.data.githubIssueId == resource.data.githubIssueId
        && request.resource.data.githubIssueNumber == resource.data.githubIssueNumber
        && request.resource.data.githubIssueUrl == resource.data.githubIssueUrl
        && request.resource.data.githubIssueRepo == resource.data.githubIssueRepo
        && request.resource.data.exportedToGithubAt == resource.data.exportedToGithubAt
      );
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // Required for collectionGroup("members") lookups during session sync.
    match /{path=**}/members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTeamAdmin(teamId)
          || (
            isSignedIn()
            && request.auth.uid == memberId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.teamId == teamId
          );
      }

      match /seasons/{seasonId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTeamAdmin(teamId);
      }

      match /fineRules/{ruleId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTeamAdmin(teamId);
      }

      match /fines/{fineId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTeamAdmin(teamId);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isTeamAdmin(teamId);
      }

      match /activityLog/{logId} {
        allow read: if isSignedIn();
        allow create: if isTeamAdmin(teamId);
        allow update, delete: if false;
      }

      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
